{
    // Press F5, or open Run and Debug (the play button with a bug on the left) and pick one of these.
    // Breakpoints go in your own files: click left of a line number so a red dot appears.
    "version": "0.2.0",
    "inputs": [
        {
            "id": "quest",
            "type": "promptString",
            "description": "Which quest? For example Quest03",
            "default": "Quest01"
        }
    ],
    "configurations": [
        {
            "name": "Run this file",
            "type": "java",
            "request": "launch",
            "mainClass": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Check one quest",
            "type": "java",
            "request": "launch",
            "mainClass": "RunAll",
            "args": ["${input:quest}"],
            "console": "integratedTerminal"
        },
        {
            "name": "Play the game",
            "type": "java",
            "request": "launch",
            "mainClass": "Play",
            "console": "integratedTerminal"
        }
    ]
}
